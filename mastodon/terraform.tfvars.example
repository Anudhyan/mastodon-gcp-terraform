# Rename to terraform.tfvars

project = "my-gcp-mastodon-project-999999"

credentials_file_path = "../terraform-sa.json"

# Pass these values from the dependencies module instead of using remote state.
dependencies = {
	gke_endpoint       = ""
	gke_ca_certificate = ""
	gcs_name           = ""
	gcs_region         = ""
	s3_access_key      = ""
	s3_access_secret   = ""
	db_hostname        = ""
	db_name            = ""
	db_user            = ""
	db_pass             = ""
	redis_hostname     = ""
	redis_port         = 6379
	redis_auth_string   = ""
	ingress_ipv4_name  = ""
}

# Mastodon Helm chart env vars
active_record_encryption_primary_key         = ""
active_record_encryption_deterministic_key   = ""
active_record_encryption_key_derivation_salt = ""
create_admin                                 = true
create_admin_email                           = "pat@example.com"
create_admin_username                        = "Pat"
local_domain                                 = "example.com"
logLevel_rails                               = "warn"
logLevel_streaming                           = "warn"
secret_key_base                              = "jihgfedcba0987654321zyxwvutsrqponmlkjihgfedcba0987654321zyxwvutsrqponmlkjihgfedcba0987654321zyxwvutsrqponmlkjihgfedcba0987654321"
smtp_auth_method                             = "plain"
smtp_enable_starttls                         = "auto"
smtp_from_address                            = "notifications@example.com"
smtp_login                                   = "apikey"
smtp_openssl_verify_mode                     = "peer"
smtp_password                                = "1234567890abcdefghijkl.MNOPQRSTUVQWXYZ1234567890abcd_EF_g_HIJKLmNO"
smtp_port                                    = 587
smtp_server                                  = "smtp.sendgrid.net"
vapid_private_key                            = "1234567890ABCDEFGHIJKLMNOPQRSTUVWZYZabcdefg="
vapid_public_key                             = "AB-CDEFGHIJKLMNOPQRSTUVWYZ1234567890abcdefghijklmnopqrstuvwxyz1234567-90ABCDEFGHIJKLMNO="
